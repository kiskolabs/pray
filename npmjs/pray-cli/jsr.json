{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@kiskolabs/pray-cli",
  "version": "1.23.0",
  "license": "MIT",
  "exports": "./src/index.ts",
  "publish": {
    "include": [
      "LICENSE.md",
      "README.md",
      "package.json",
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "src/**/*.integration.test.ts",
      "src/**/*.support.ts",
      "src/render-test-package.ts"
    ]
  }
}
