{
  "name": "pray-cli",
  "version": "1.24.0",
  "description": "Prayfile CLI — resolve, lock, render, and verify inference input packages (depends on pray-core)",
  "author": "Andrei Makarov <contact@kiskolabs.com>",
  "license": "MIT",
  "homepage": "https://pray.kisko.dev",
  "bugs": {
    "url": "https://github.com/kiskolabs/pray/issues"
  },
  "type": "module",
  "bin": {
    "pray": "./bin/pray.js"
  },
  "exports": {
    "./cli": {
      "types": "./dist/cli/main.d.ts",
      "import": "./dist/cli/main.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --prefix ../pray-core && rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && rm -rf dist-test && tsc -p tsconfig.test.json && node --test 'dist-test/**/*.test.js'",
    "test:bun": "npm run build && bun scripts/runtime-smoke.mjs",
    "test:deno": "npm run build && deno run --node-modules-dir=auto --allow-all scripts/runtime-smoke.mjs",
    "test:workers-parse": "node scripts/workers-parse-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check . && npm run lint:cycles",
    "libyears": "libyear --dev --quiet",
    "lint:cycles": "madge --circular --extensions ts --ts-config tsconfig.json src/cli/main.ts src/parse.ts",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pray-core": "1.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.15.0",
    "madge": "^8.0.0",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "pray",
    "prayfile",
    "agents",
    "inference",
    "package-manager",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiskolabs/pray.git",
    "directory": "npmjs/pray-cli"
  }
}
